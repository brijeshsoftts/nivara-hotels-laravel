{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],

        "module": "ESNext",
        "moduleResolution": "Bundler",

        "jsx": "react-jsx",

        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "resolveJsonModule": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,

        "paths": {
            "@/*": ["./resources/js/*"]
        },

        "types": ["vite/client"]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "resources/js/**/*.vue",
        "vite.config.ts"
    ]
}
